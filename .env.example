# Swarm configuration. Copy to `.env` (git-ignored) and fill in what you need.
# Every variable is optional for local development unless marked REQUIRED FOR ...

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Turns on demo-only features such as the Telegram /as command and the demo panel, and
# makes the Swarm Clock manual (the demo panel moves it). With DEMO_MODE=false the clock is
# real time and the week's steps run on a schedule (Asia/Singapore).
DEMO_MODE=true
# Optional: require this key (sent as the X-Demo-Key header) for demo panel actions.
DEMO_PANEL_KEY=
# Seed the Tiong Bahru demo world on startup when the database is empty.
AUTO_SEED=true
# The Monday the demo week starts on (fixed so the demo always shows the same numbers).
DEMO_WEEK=2026-10-12
# Signs the links Swarm sends owners (Telegram invites, Connect PayPal). Required when
# DEMO_MODE=false. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres. docker-compose exposes it on port 5434 (override with SWARM_DB_PORT).
DATABASE_URL=postgresql+psycopg://swarm:swarm@localhost:5434/swarm
TEST_DATABASE_URL=postgresql+psycopg://swarm:swarm@localhost:5434/swarm_test
SWARM_DB_PORT=5434

# Public URLs. Used for PayPal return/cancel URLs, webhooks and CORS.
PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM (REQUIRED FOR agents, phase 3+)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# PayPal (REQUIRED FOR real sandbox calls and scripts/paypal_smoke.py)
# Get these from https://developer.paypal.com > Apps & Credentials (Sandbox).
# ---------------------------------------------------------------------------
# sandbox only. The code refuses to run against live.
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=SGD

# The Swarm platform business account: merchant of record, places holds, sends payouts.
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
# Sandbox email of the platform business account (suppliers invoice this address).
PAYPAL_PLATFORM_EMAIL=
# ID of the webhook registered on the platform app (Developer Dashboard > app > Webhooks).
PAYPAL_WEBHOOK_ID=
# Platform fee taken from supplier payouts, in basis points (200 = 2%).
PLATFORM_FEE_BPS=200

# Suppliers: one sandbox business account + REST app each. The database stores only the
# prefix (for example PAYPAL_SUPPLIER_FRESHDAIRY); the code appends _CLIENT_ID etc.
PAYPAL_SUPPLIER_FRESHDAIRY_CLIENT_ID=
PAYPAL_SUPPLIER_FRESHDAIRY_CLIENT_SECRET=
PAYPAL_SUPPLIER_FRESHDAIRY_EMAIL=
PAYPAL_SUPPLIER_PACKPRO_CLIENT_ID=
PAYPAL_SUPPLIER_PACKPRO_CLIENT_SECRET=
PAYPAL_SUPPLIER_PACKPRO_EMAIL=
PAYPAL_SUPPLIER_JOHORFARM_CLIENT_ID=
PAYPAL_SUPPLIER_JOHORFARM_CLIENT_SECRET=
PAYPAL_SUPPLIER_JOHORFARM_EMAIL=

# Shops that use REAL sandbox money (comma-separated shop codes). All others are simulated.
REAL_SHOP_CODES=cafe-mei,bakery-lim,kopi-corner,brew-lab
# Sandbox personal-account email per REAL shop (receives swap payouts). Key: shop code in
# upper case with dashes as underscores.
PAYPAL_SHOP_CAFE_MEI_EMAIL=
PAYPAL_SHOP_BAKERY_LIM_EMAIL=
PAYPAL_SHOP_KOPI_CORNER_EMAIL=
PAYPAL_SHOP_BREW_LAB_EMAIL=
# Optional: a saved PayPal vault ID for a REAL shop (for example the one printed by
# `make smoke`). Without it the owner connects PayPal once on /connect/<shop-code>.
PAYPAL_SHOP_CAFE_MEI_VAULT_ID=
PAYPAL_SHOP_BAKERY_LIM_VAULT_ID=
PAYPAL_SHOP_KOPI_CORNER_VAULT_ID=
PAYPAL_SHOP_BREW_LAB_VAULT_ID=

# Smoke script only: which supplier app to use for the invoice steps, and which sandbox
# email receives the test payout (defaults to that supplier's email).
SMOKE_SUPPLIER_PREFIX=PAYPAL_SUPPLIER_FRESHDAIRY
SMOKE_PAYOUT_RECEIVER=

# ---------------------------------------------------------------------------
# Telegram (optional: without it owners use the web phone in the demo panel)
# Create a bot with @BotFather and paste its token. Locally the bot uses long polling;
# when PUBLIC_BACKEND_URL is https it registers a webhook at /telegram/webhook instead.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends back on every webhook call (production only).
TELEGRAM_WEBHOOK_SECRET=
